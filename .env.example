# Create a free key at https://console.groq.com/keys. Do not enable paid billing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Independent free lesson/chat backup: https://openrouter.ai/settings/keys
# Add at least one backup key so Groq quotas do not block lessons.
OPENROUTER_API_KEY=
# Only openrouter/free or an explicit :free model is allowed. Never a paid model.
OPENROUTER_MODEL=particle-ai/particle-1:free
